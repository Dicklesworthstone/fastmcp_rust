+    let contract = ToolContract::admit(tool(source.clone(), None)).unwrap();
+    let review = reviewed_input(target.as_str(), "calculate", source.clone());
+    contract.admit_headers(&target, &review).unwrap();
+    contract.invalidated.store(true, Ordering::Release);
+    assert!(matches!(contract.admit_headers(&target, &review), Err(ManagedToolError::Invalidated)));
+    ToolContract::admit(tool(source, None)).unwrap().admit_headers(&target, &review).unwrap();
+}
