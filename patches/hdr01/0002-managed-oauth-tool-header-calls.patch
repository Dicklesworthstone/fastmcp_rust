+#[test]
+fn valid_large_integers_remain_body_only_until_header_projection_is_requested() {
+    use crate::http_executor::ModernHttpRequest;
+    use fastmcp_protocol::FINAL_PROTOCOL_VERSION;
+    use fastmcp_protocol::http_headers::MAX_PARAMETER_HEADER_INTEGER;
+
+    let target = CanonicalHttpUrl::parse("https://tools.example/mcp").unwrap();
+    let source = annotated_input_schema();
+    let contract = ToolContract::admit(tool(source.clone(), None)).unwrap();
+    let request = request("tools/call", json!({"name":"calculate","arguments":{"count":MAX_PARAMETER_HEADER_INTEGER + 1}}));
+    contract.validate_request(&request).unwrap();
+    let body = serde_json::to_vec(&json!({"jsonrpc":"2.0","id":1,"method":"tools/call","params":request.encode_params().unwrap().unwrap()})).unwrap();
+    let wire = ModernHttpRequest::new(target.as_str(), body, FINAL_PROTOCOL_VERSION, "tools/call", Some("calculate".to_owned())).unwrap();
+    assert!(!wire.headers().iter().any(|(name, _)| name.starts_with("Mcp-Param-")));
+    let review = reviewed_input(target.as_str(), "calculate", source);
+    contract.admit_headers(&target, &review).unwrap();
+    assert!(matches!(wire.with_reviewed_tool_headers(&review), Err(ToolHeaderDispatchError::Projection(_))));
+}
